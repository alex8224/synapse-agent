<Window x:Class="WindowsCapture.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="windows-capture" Height="640" Width="960"
        MinHeight="480" MinWidth="720"
        Closing="OnWindowClosing">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- target picker -->
        <DockPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock DockPanel.Dock="Left" Text="Target window" FontWeight="SemiBold"
                       VerticalAlignment="Center" Margin="0,0,8,0" />
            <Button DockPanel.Dock="Right" Content="Refresh" Width="90" Margin="8,0,0,0"
                    Click="OnRefreshClick" />
            <TextBlock x:Name="SelectedTargetText" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" Foreground="#444" />
        </DockPanel>

        <ListView x:Name="WindowList" Grid.Row="1" SelectionMode="Single"
                  SelectionChanged="OnWindowSelectionChanged">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="HWND" Width="90" DisplayMemberBinding="{Binding Hwnd}" />
                    <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}" />
                    <GridViewColumn Header="Process" Width="140" DisplayMemberBinding="{Binding Process}" />
                    <GridViewColumn Header="Title" Width="480" DisplayMemberBinding="{Binding Title}" />
                    <GridViewColumn Header="Min" Width="50" DisplayMemberBinding="{Binding Minimized}" />
                </GridView>
            </ListView.View>
        </ListView>

        <!-- parameters -->
        <GroupBox Grid.Row="2" Header="Capture parameters (temporary; use Settings to persist)"
                  Margin="0,8,0,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Count" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox Grid.Column="1" x:Name="CountBox" />

                <TextBlock Grid.Column="2" Text="Interval ms" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Grid.Column="3" x:Name="IntervalBox" />

                <TextBlock Grid.Column="4" Text="Start delay ms" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Grid.Column="5" x:Name="StartDelayBox" />

                <TextBlock Grid.Column="6" Text="Max edge" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Grid.Column="7" x:Name="MaxEdgeBox" />

                <TextBlock Grid.Column="8" Text="Output dir" VerticalAlignment="Center" Margin="12,0,6,0" />
                <TextBox Grid.Column="9" x:Name="OutputDirBox" />
            </Grid>
        </GroupBox>

        <!-- actions -->
        <DockPanel Grid.Row="3" Margin="0,8,0,0">
            <Button DockPanel.Dock="Left" Content="Start" Width="110" Height="30" Click="OnStartClick" />
            <Button DockPanel.Dock="Left" Content="Cancel" Width="110" Height="30" Margin="8,0,0,0"
                    Click="OnCancelClick" />
            <Button DockPanel.Dock="Right" Content="Exit (release)" Width="130" Height="30"
                    Click="OnExitClick" />
            <Button DockPanel.Dock="Right" Content="Settings..." Width="110" Height="30" Margin="0,0,8,0"
                    Click="OnSettingsClick" />
        </DockPanel>

        <!-- status -->
        <Border Grid.Row="4" Margin="0,8,0,0" Padding="8" Background="#F3F3F3" CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
                <TextBlock x:Name="JobText" TextWrapping="Wrap" Foreground="#555" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
