<Window x:Class="WindowsCapture.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="windows-capture settings" Height="560" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" TextWrapping="Wrap" Foreground="#444" Margin="0,0,0,10"
                   Text="These values are persisted to the config file and used when a capture request does not override them. Precedence: temporary override &gt; saved config &gt; built-in default." />

        <GroupBox Grid.Row="1" Header="Defaults" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Frame count" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="CountBox" Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Interval (ms)" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="IntervalBox" Margin="0,0,0,6" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Start delay (ms)" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="StartDelayBox" Margin="0,0,0,6" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Max edge (0 = native)" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBox Grid.Row="3" Grid.Column="1" x:Name="MaxEdgeBox" Margin="0,0,0,6" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Result TTL (seconds)" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="TtlBox" Margin="0,0,0,6" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Frame timeout (ms)" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBox Grid.Row="5" Grid.Column="1" x:Name="FrameTimeoutBox" Margin="0,0,0,6" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Output directory" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBox Grid.Row="6" Grid.Column="1" x:Name="OutputDirBox" Margin="0,0,0,6" />

                <CheckBox Grid.Row="7" Grid.Column="1" x:Name="AllowReuseBox" Margin="0,4,0,0"
                          Content="Report the previous frame when a window does not recompose (marked as reused)" />
            </Grid>
        </GroupBox>

        <GroupBox Grid.Row="2" Header="Runtime" Margin="0,0,0,10">
            <TextBlock x:Name="RuntimeText" Margin="10" TextWrapping="Wrap" Foreground="#444" />
        </GroupBox>

        <TextBlock Grid.Row="3" TextWrapping="Wrap" Foreground="#666"
                   Text="Note: Windows Graphics Capture only delivers a frame when the target window recomposes. For a static window a tick is reported with source=&quot;reused&quot; and the original captured_at timestamp - the tool never re-labels an old frame as new." />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="100" Height="28" IsDefault="True" Click="OnSaveClick" />
            <Button Content="Cancel" Width="100" Height="28" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
