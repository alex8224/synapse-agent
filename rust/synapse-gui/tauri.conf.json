{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Synapse",
  "version": "0.1.0",
  "identifier": "com.synapse.gui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Synapse",
        "label": "splash",
        "url": "index.html",
        "decorations": false,
        "transparent": true,
        "width": 400,
        "height": 250,
        "center": true,
        "resizable": false,
        "visible": true,
        "alwaysOnTop": true
      },
      {
        "title": "Synapse",
        "label": "main",
        "url": "index.html",
        "decorations": false,
        "transparent": false,
        "width": 1280,
        "height": 840,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/*"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
