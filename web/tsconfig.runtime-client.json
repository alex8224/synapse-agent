{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.runtime-client.tsbuildinfo",
    "target": "es2023",
    /* Boundary config: the shared protocol core is host-agnostic, so it is
       checked with the ES library only. No DOM lib, no vite/client types: a
       stray `window` / `document` / `location` / `WebSocket` reference fails
       here instead of silently depending on the browser. */
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/runtime-client"]
}